{
  "name": "StayPay",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "forwardPorts": [8000, 8100, 5432, 6379, 8089],
  "postCreateCommand": "pip install -e '.[dev]' && cp -n .env.example .env; sed -i 's/localhost:5432/postgres:5432/; s/localhost:6379/redis:6379/' .env && alembic upgrade head",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python", "ms-python.vscode-pylance", "ms-python.debugpy", "charliermarsh.ruff",
        "mtxr.sqltools", "mtxr.sqltools-driver-pg", "humao.rest-client", "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker", "github.vscode-github-actions", "eamodio.gitlens"
      ],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
